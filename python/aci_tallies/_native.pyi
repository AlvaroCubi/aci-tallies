def open_mctal(path: _Path, input: _Path | Input | None = None) -> MctalFile: ...

_U32: TypeAlias = npt.NDArray[np.uint32]

def open_cuvmsh(path: _Path, input: _Path | Input | None = None) -> CuvFile: ...
def open_meshinfo(path: _Path, input: _Path | Input | None = None) -> CuvFile: ...
def open_cuv_mesh(
