"""Types of the Rust extension module `aci_tallies._native`."""

import os
from collections.abc import Iterator, Sequence
from typing import Any, Literal, TypeAlias

import numpy as np
import numpy.typing as npt

_F64: TypeAlias = npt.NDArray[np.float64]
_Path: TypeAlias = str | os.PathLike[str]
_Index: TypeAlias = int | Literal["total"]
_Select: TypeAlias = int | slice | Literal["total"] | None
_MeshSelect: TypeAlias = int | slice | None
_VtkIndices: TypeAlias = _Index | Sequence[_Index] | None

def detect(path: _Path) -> Literal["meshtal", "mctal", "cuvmsh", "meshinfo"] | None: ...

class ReadWarning:
    """A problem found while reading that didn't stop it."""

    @property
    def line(self) -> int | None: ...
    @property
    def message(self) -> str: ...

class Axis:
    """The bins of one dimension of a tally (energy, time, ...)."""

    @property
    def bounds(self) -> _F64 | None: ...
    @property
    def n_bins(self) -> int: ...
    @property
    def total(self) -> bool: ...
    @property
    def total_index(self) -> int | None: ...
    @property
    def upper(self) -> _F64 | None: ...
    @property
    def cumulative(self) -> bool: ...
    def __len__(self) -> int: ...

class Input:
    """An MCNP input, parsed once to be used for several files."""

    def __init__(self, path: _Path) -> None: ...
    @staticmethod
    def from_text(text: str) -> Input: ...

class Geometry:
    """A structured mesh: rectangular or cylindrical."""

    @property
    def kind(self) -> Literal["rectangular", "cylindrical"]: ...
    @property
    def axis_names(self) -> tuple[str, str, str]: ...
    @property
    def bounds(self) -> tuple[_F64, _F64, _F64]: ...
    @property
    def shape(self) -> tuple[int, int, int]: ...
    @property
    def origin(self) -> list[float] | None: ...
    @property
    def axis(self) -> list[float] | None: ...
    @property
    def vec(self) -> list[float] | None: ...
    @property
    def transform(self) -> _F64 | None: ...
    def volumes(self) -> _F64: ...
    def centers(self) -> _F64: ...
    def locate(self, points: npt.ArrayLike) -> npt.NDArray[np.int64]: ...
    def _vtk_layout(self, max_theta_step: float) -> dict[str, Any]: ...
    @property
    def _vtk_extension(self) -> str: ...
    def _write_vtk(
        self,
        path: _Path,
        names: list[str],
        arrays: list[_F64],
        max_theta_step: float,
        compress: bool,
    ) -> None: ...

class TallyInfo:
    """What a mesh tally is, without its values."""

    @property
    def id(self) -> int: ...
    @property
    def particle(self) -> str: ...
    @property
    def comment(self) -> str | None: ...
    @property
    def geometry(self) -> Geometry: ...
    @property
    def energy(self) -> Axis: ...
    @property
    def time(self) -> Axis: ...
    @property
    def out_format(self) -> str: ...
    @property
    def geometry_from_input(self) -> bool: ...
    @property
    def energy_weighted(self) -> bool | None: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def warnings(self) -> list[ReadWarning]: ...

class MeshTally:
    """One mesh tally: values and relative errors, shape `(energy, time, i, j, k)`."""

    @property
    def id(self) -> int: ...
    @property
    def particle(self) -> str: ...
    @property
    def comment(self) -> str | None: ...
    @property
    def geometry(self) -> Geometry: ...
    @property
    def energy(self) -> Axis: ...
    @property
    def time(self) -> Axis: ...
    @property
    def out_format(self) -> str: ...
    @property
    def geometry_from_input(self) -> bool: ...
    @property
    def energy_weighted(self) -> bool | None: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def result(self) -> _F64: ...
    @property
    def rel_error(self) -> _F64: ...
    @property
    def volume(self) -> _F64 | None: ...
    @property
    def warnings(self) -> list[ReadWarning]: ...
    def info(self) -> TallyInfo: ...
    def isel(
        self,
        energy: _Select = None,
        time: _Select = None,
        i: _MeshSelect = None,
        j: _MeshSelect = None,
        k: _MeshSelect = None,
    ) -> MeshTally: ...
    def integrate_energy(self) -> MeshTally: ...
    def integrate_time(self) -> MeshTally: ...
    def integrate_space(self) -> MeshTally: ...
    def __add__(self, other: MeshTally) -> MeshTally: ...
    def __sub__(self, other: MeshTally) -> MeshTally: ...
    def __mul__(self, other: MeshTally | float) -> MeshTally: ...
    def __rmul__(self, other: float) -> MeshTally: ...
    def __truediv__(self, other: MeshTally | float) -> MeshTally: ...
    def __neg__(self) -> MeshTally: ...
    def to_polars(self) -> Any: ...
    def to_parquet(self, path: _Path) -> None: ...
    def to_xarray(self) -> Any: ...
    def to_pyvista(
        self,
        energy: _VtkIndices = None,
        time: _VtkIndices = None,
        fields: Sequence[str] | None = None,
        max_theta_step: float | None = None,
    ) -> Any: ...
    def to_vtk(
        self,
        path: _Path,
        energy: _VtkIndices = None,
        time: _VtkIndices = None,
        fields: Sequence[str] | None = None,
        max_theta_step: float | None = None,
        compress: bool = True,
    ) -> None: ...
    def _repr_html_(self) -> str: ...

class MeshtalFile:
    """An indexed meshtal file; values are read when asked for."""

    @property
    def path(self) -> str | None: ...
    @property
    def title(self) -> str: ...
    @property
    def histories(self) -> float | None: ...
    @property
    def code(self) -> tuple[str, str]: ...
    @property
    def probid(self) -> str: ...
    @property
    def ids(self) -> list[int]: ...
    @property
    def tallies(self) -> list[TallyInfo]: ...
    @property
    def failed(self) -> list[tuple[int, str]]: ...
    def info(self, id: int) -> TallyInfo: ...
    def is_current(self) -> bool: ...
    def read(
        self, id: int, energy: _Index | None = None, time: _Index | None = None
    ) -> MeshTally: ...
    def read_all(self) -> list[MeshTally]: ...
    def keys(self) -> list[int]: ...
    def __len__(self) -> int: ...
    def __contains__(self, id: int) -> bool: ...
    def __getitem__(self, id: int) -> MeshTally: ...
    def __iter__(self) -> Iterator[int]: ...
    def _repr_html_(self) -> str: ...

def open_meshtal(path: _Path, input: _Path | Input | None = None) -> MeshtalFile: ...

class Tfc:
    """A tally fluctuation chart."""

    @property
    def bin(self) -> list[int]: ...
    @property
    def histories(self) -> npt.NDArray[np.uint64]: ...
    @property
    def mean(self) -> _F64: ...
    @property
    def rel_error(self) -> _F64: ...
    @property
    def fom(self) -> _F64 | None: ...

class Kcode:
    """A KCODE run's estimates per cycle."""

    @property
    def cycles(self) -> int: ...
    @property
    def inactive(self) -> int: ...
    @property
    def columns(self) -> list[str]: ...
    @property
    def values(self) -> _F64: ...
    def __getitem__(self, name: str) -> _F64: ...

class Bin:
    """A cell or surface bin as MCNP makes it from the input."""

    @property
    def total(self) -> bool: ...
    @property
    def levels(self) -> list[list[tuple[int, int | None, list[int] | None]]]: ...

class MctalInfo:
    """What an MCTAL tally is, without its values (`aci_tallies.mctal.TallyInfo`)."""

    @property
    def id(self) -> int: ...
    @property
    def kind(self) -> int: ...
    @property
    def particles(self) -> str: ...
    @property
    def detector(self) -> str | None: ...
    @property
    def modifier(self) -> str: ...
    @property
