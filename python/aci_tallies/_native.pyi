class MctalTally(MctalInfo):
    """One MCTAL tally (`aci_tallies.mctal.Tally`): values over `f d u s m c e t`."""

    @property
    def perturbation(self) -> int | None: ...
    @property
    def result(self) -> _F64: ...
    @property
    def rel_error(self) -> _F64: ...
    @property
    def tfc(self) -> Tfc | None: ...
    def info(self) -> MctalInfo: ...
    def isel(self, **selected: _Select) -> MctalTally: ...
    def integrate(self, *dims: str) -> MctalTally: ...
    def __add__(self, other: MctalTally) -> MctalTally: ...
    def __sub__(self, other: MctalTally) -> MctalTally: ...
    def __mul__(self, other: MctalTally | float) -> MctalTally: ...
    def __rmul__(self, other: float) -> MctalTally: ...
    def __truediv__(self, other: MctalTally | float) -> MctalTally: ...
    def __neg__(self) -> MctalTally: ...
    def to_polars(self) -> Any: ...
    def to_parquet(self, path: _Path) -> None: ...
    def to_xarray(self) -> Any: ...
    def _repr_html_(self) -> str: ...

